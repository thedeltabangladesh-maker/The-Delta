---
import { SITE, CATEGORIES } from '../consts';
import { slugify } from '../lib/articles';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  author?: string;
  /** set true on the CMS/utility pages to keep them out of Google */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedDate,
  author,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const today = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const navCats = CATEGORIES.slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / link previews -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- RSS autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Articles`} href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <div class="topbar">
      <div class="wrap">
        <span class="today">{today}</span>
        <span>Dhaka, Bangladesh</span>
      </div>
    </div>

    <header class="masthead">
      <a class="brand" href="/">
        <h1 class="brand-name">{SITE.name}</h1>
      </a>
      <p class="brand-tag">{SITE.tagline}</p>
    </header>

    <nav class="mainnav" aria-label="Primary">
      <div class="wrap">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
        {navCats.map((c) => (
          <a href={`/category/${slugify(c)}`}>{c}</a>
        ))}
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap cols">
        <div>
          <p class="brand-name">{SITE.name}</p>
          <p>{SITE.description}</p>
          {SITE.links.email && (
            <p><a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a></p>
          )}
        </div>
        <div>
          <h4>Topics</h4>
          <ul>
            {CATEGORIES.map((c) => (
              <li><a href={`/category/${slugify(c)}`}>{c}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4>More</h4>
          <ul>
            <li><a href="/">Latest stories</a></li>
            <li><a href="/about">About this site</a></li>
            <li><a href="/rss.xml">RSS feed</a></li>
            {SITE.links.facebook && <li><a href={SITE.links.facebook}>Facebook</a></li>}
            {SITE.links.twitter && <li><a href={SITE.links.twitter}>Twitter / X</a></li>}
          </ul>
        </div>
      </div>
      <div class="wrap legal">
        <span>© {new Date().getFullYear()} {SITE.publisher}. All rights reserved.</span>
        <span>Independent environmental journalism.</span>
      </div>
    </footer>
  </body>
</html>
