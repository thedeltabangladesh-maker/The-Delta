---
import ShareButton from '../../components/ShareButton.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles, slugify, formatDate, readingTime } from '../../lib/articles';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;
const author = data.author || SITE.defaultAuthor;

// Up to three more stories in the same topic.
const all = await getPublishedArticles();
const related = all
  .filter((a) => a.id !== article.id && a.data.category === data.category)
  .slice(0, 3);
---

<BaseLayout
  title={data.title}
  description={data.dek ?? SITE.description}
  image={data.heroImage}
  type="article"
  publishedDate={data.pubDate}
  author={author}
>
  <article class="article">
    <div class="article-head">
      <a class="kicker" href={`/category/${slugify(data.category)}`}>{data.category}</a>
      <h1>{data.title}</h1>
      {data.dek && <p class="dek">{data.dek}</p>}
      <div class="byline">
        <span class="author">{author}</span>
        <span class="dot">·</span>
        <span>{formatDate(data.pubDate)}</span>
        <span class="dot">·</span>
        <span>{readingTime(article.body)}</span> 
<span class="dot">·</span>
      <ShareButton title={data.title} variant="byline" />
      </div>
    </div>

    {data.heroImage && (
      <figure class="hero-figure">
        <img src={data.heroImage} alt={data.heroCaption ?? data.title} />
        {data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <div class="article-foot">
      <a class="backlink" href="/">← All stories</a> <ShareButton title={data.title} variant="foot" />
    </div>
  </article>

  {related.length > 0 && (
    <section class="more">
      <div class="wrap">
        <div class="section-head"><h2>More on {data.category}</h2></div>
        <div class="grid">
          {related.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
