---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <div class="pagehead">
    <span class="kicker">Error 404</span>
    <h1>This page has washed away</h1>
    <p>The page you were looking for doesn’t exist or has moved.</p>
  </div>
  <div class="page-body" style="text-align:center;">
    <p><a class="backlink" href="/">← Back to the front page</a></p>
  </div>
</BaseLayout>
